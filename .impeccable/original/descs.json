"{\n \"sel\": \"product_extra-300 panel panel-active / parent panel-group product_extra product_accordion product_accordion-bottom\",\n \"premium-elderflower-rye-moonshine-07l-45-vol\": {\n  \"desc\": \"Elderberry-rye samohon is a strong alcoholic beverage.\\nA delicate combination of selected rye grains and natural elderberry juice\\ngives it a mild flavor, light aroma of berries and the smell of fresh rye\\nbread.\",\n  \"img\": [\n   \"https://bilahuralnia.com/image/cache/catalog/logo/logo%20(1)-446x167.png\",\n   \"https://bilahuralnia.com/image/cache/catalog/FOTOANGL/Elderberry-Rye%20grey-1000x1000h.jpg\",\n   \"https://bilahuralnia.com/image/cache/catalog/logo/Logo-150x54fill.png\"\n  ]\n },\n \"premium-elderflower-barley-moonshine-07l-45-vol\": {\n  \"desc\": \"Elderberry-barley samohon is a strong alcoholic\\nbeverage. The balance of selected barley grains and one natural elderberry\\njuice gives it a mild flavor and subtle berry aroma.\",\n  \"img\": [\n   \"https://bilahuralnia.com/image/cache/catalog/logo/logo%20(1)-446x167.png\",\n   \"https://bilahuralnia.com/image/cache/catalog/FOTOANGL/Elderberry-Barley%20grey-1000x1000h.jpg\",\n   \"https://bilahuralnia.com/image/cache/catalog/logo/Logo-150x54fill.png\"\n  ]\n },\n \"premium-wheat-moonshine-07-l-45-vol\": {\n  \"desc\": \"Write a review\\n        \\n      Your Name\\n      \\n        \\n      \\n    \\n    \\n      Your Review\\n      \\n        \\n        Note: HTML is not translated!\\n      \\n    \\n    \\n      Rating\\n\\n      \\n        Bad\\n        \\n\\n        \\n\\n        \\n\\n        \\n\\n        \\n        Good\\n      \\n    \\n    \\n    \\n      \\n        Continue\",\n  \"img\": [\n   \"https://bilahuralnia.com/image/cache/catalog/logo/logo%20(1)-446x167.png\",\n   \"https://bilahuralnia.com/image/cache/catalog/FOTOANGL/Wheat%20grey-1000x1000h.jpg\",\n   \"https://bilahuralnia.com/image/cache/catalog/logo/Logo-150x54fill.png\"\n  ]\n },\n \"premium-moonshine-rakia-07-l-45-vol\": {\n  \"desc\": \"Rakia\\nis a strong alcoholic drink based on a mix of 100% fruit juices.\\n\\nIt\\nhas a mild flavor and pleasant aroma, in which fruity notes are noticeable.\",\n  \"img\": [\n   \"https://bilahuralnia.com/image/cache/catalog/logo/logo%20(1)-446x167.png\",\n   \"https://bilahuralnia.com/image/cache/catalog/RAKIYA-1000x1000h.jpg\",\n   \"https://bilahuralnia.com/image/cache/catalog/logo/Logo-150x54fill.png\"\n  ]\n },\n \"premium-moonshine-chacha-07-l-45-vol-ua\": {\n  \"desc\": \"Chacha\\nis a strong alcoholic beverage, made\\nfrom the natural juice of dark grape varieties, which gives it a richer and\\nmore harmonious taste and pleasant aroma.\",\n  \"img\": [\n   \"https://bilahuralnia.com/image/cache/catalog/logo/logo%20(1)-446x167.png\",\n   \"https://bilahuralnia.com/image/cache/catalog/CHACHA-1000x1000h.jpg\",\n   \"https://bilahuralnia.com/image/cache/catalog/logo/Logo-150x54fill.png\"\n  ]\n },\n \"gift-set-white-guralnia\": {\n  \"desc\": \"The Bila Huralnya gift set is\\nalways a good opportunity to appreciate the amazing flavor of premium\\nmoonshine.\\n\\nIt consists of four items: Chacha, Rakia,\\nElderberry-Rye and Elderberry-Barley Samohon.\",\n  \"img\": [\n   \"https://bilahuralnia.com/image/cache/catalog/logo/logo%20(1)-446x167.png\",\n   \"https://bilahuralnia.com/image/cache/catalog/4%20пляшки-1000x1000w.jpg\",\n   \"https://bilahuralnia.com/image/cache/catalog/logo/Logo-150x54fill.png\"\n  ]\n },\n \"premium-elderflower-and-rye-moonshine-glory-ukraine-gift-box\": {\n  \"desc\": \"Elderberry-rye samohon is a strong alcoholic beverage.\\nThe delicate combination of selected rye grains and natural elderberry juice\\ngives it a mild taste, light aroma of berries and the smell of fresh rye bread.\",\n  \"img\": [\n   \"https://bilahuralnia.com/image/cache/catalog/logo/logo%20(1)-446x167.png\",\n   \"https://bilahuralnia.com/image/cache/catalog/Slava%20Ukraini-1000x1000h.jpg\",\n   \"https://bilahuralnia.com/image/cache/catalog/-1-м