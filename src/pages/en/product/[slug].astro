---
import Base from '../../../layouts/Base.astro';
import ProductPage from '../../../components/ProductPage.astro';
import { products, type Product } from '../../../data/products';

export const getStaticPaths = () => products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
const { product } = Astro.props as { product: Product };
---
<Base lang="en" path={`/product/${product.slug}/`} title={`${product.name.en} — ${product.kind.en}`} description={product.desc?.en}><ProductPage lang="en" product={product} /></Base>
